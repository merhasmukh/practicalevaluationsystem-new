# Google OAuth 2.0  (set ENABLE_GOOGLE_LOGIN=true only on public deployments with a registered redirect URI)
ENABLE_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8501"
GOOGLE_HOSTED_DOMAIN="gujaratvidyapith.org"

# Administrator emails (comma-separated list)
ADMIN_EMAILS="admin@gujaratvidyapith.org"
# Admin login password (applied to ALL admin accounts during seed — CHANGE THIS)
ADMIN_PASSWORD="admin@123"

# Database Configuration (Option A: DATABASE_URL, Option B: MySQL discrete params)
# DATABASE_URL="mysql+pymysql://tpems_user:password@localhost:3306/tpems"
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_USER="tpems_user"
# MYSQL_PASSWORD="password"
# MYSQL_DATABASE="tpems"
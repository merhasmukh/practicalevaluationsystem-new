# Streamlit Secrets Template (.streamlit/secrets.toml)
# -------------------------------------------------------------
# On Streamlit Community Cloud:
# 1. Open your App Dashboard → click "⋮" menu → "Settings" → "Secrets"
# 2. Copy everything below, fill in your real values, and Save.
#
# For Local Development:
# Copy this file to `.streamlit/secrets.toml` (already gitignored) and fill in values.
# OR set the same keys as environment variables in a `.env` file (also gitignored).
# -------------------------------------------------------------

# ── Administrator emails ──────────────────────────────────────────────────────
# List of institutional emails that automatically receive Administrator access
# when signing in with Google.
ADMIN_EMAILS = "admin@gujaratvidyapith.org,hod.cs@gujaratvidyapith.org"

# OR use a TOML array:
# admin_emails = [
#     "admin@gujaratvidyapith.org",
#     "hod.cs@gujaratvidyapith.org",
# ]

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# From: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID     = "your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-client-secret"

# For local dev use http://localhost:8501
# For production use your live URL, e.g. https://tpems.gujaratvidyapith.org
GOOGLE_REDIRECT_URI  = "http://localhost:8501"

# Restrict sign-in to this institutional domain only
GOOGLE_HOSTED_DOMAIN = "gujaratvidyapith.org"

# ── Database (MySQL Production / SQLite Dev) ──────────────────────────────────
# Option A: Full Connection URL
# DATABASE_URL = "mysql+pymysql://tpems_user:StrongPassword@127.0.0.1:3306/tpems"

# Option B: Discrete MySQL parameters
# [mysql]
# host     = "127.0.0.1"
# port     = 3306
# user     = "tpems_user"
# password = "StrongPassword"
# database = "tpems"

# Option C: Local development default (if above are omitted)
DATABASE_URL = "sqlite:///tpems.db"

# ── Application Security ──────────────────────────────────────────────────────
SECRET_KEY = "replace-with-a-long-random-string-min-32-chars"
SESSION_TIMEOUT_MINUTES = 60

# ── SMTP Email (optional — for assignment alerts) ────────────────────────────
SMTP_HOST     = "smtp.gmail.com"
SMTP_PORT     = 587
SMTP_USER     = "your-email@gujaratvidyapith.org"
SMTP_PASSWORD = "your-gmail-app-password"
MAIL_FROM     = "your-email@gujaratvidyapith.org"

